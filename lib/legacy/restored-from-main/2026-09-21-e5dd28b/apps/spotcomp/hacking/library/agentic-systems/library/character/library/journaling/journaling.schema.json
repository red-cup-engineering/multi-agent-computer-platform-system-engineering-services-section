{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidmath.active.development.561.group/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/hacking/library/thing/library/system/library/agentic-systems/library/character/library/journaling/journaling.schema.json",
  "title": "journaling",
  "description": "Predication-shape for a journaling $thing: the structural pattern by which a character (= any directory, by the polysemy theorem) accretes cells about itself over time. Carries sub-structures memory (curated, typed, persistent across sessions) and diary (per-session timestamped EAVT rows).",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "specializing": {
      "const": "character"
    },
    "belongs-to": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "description": "The character whose journaling subtree this is."
    },
    "accretes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "memory",
          "diary"
        ]
      },
      "uniqueItems": true,
      "description": "The sub-structure kinds this journaling carries."
    }
  }
}
