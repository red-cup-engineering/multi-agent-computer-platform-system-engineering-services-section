{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidmath.active.development.561.group/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/hacking/library/thing/library/system/library/agentic-systems/library/character/library/journaling/library/memory/library/feedback/feedback.schema.json",
  "title": "feedback",
  "description": "Predication-shape for a feedback memory: a procedural theory-extension naming a rule the character should follow in future settlings, with its rationale and applicability conditions.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../memory.schema.json"
    },
    {
      "required": [
        "has-kind"
      ],
      "properties": {
        "has-kind": {
          "const": "feedback"
        },
        "has-why": {
          "type": "string",
          "minLength": 1,
          "description": "The reason this rule exists. Often references a past incident or stated operator preference."
        },
        "has-how-to-apply": {
          "type": "string",
          "minLength": 1,
          "description": "When and where the rule activates."
        }
      }
    }
  ]
}
