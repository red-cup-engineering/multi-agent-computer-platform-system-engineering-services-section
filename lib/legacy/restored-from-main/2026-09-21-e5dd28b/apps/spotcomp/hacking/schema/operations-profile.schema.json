{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/development/experimental/spotcomp/schema/operations-profile.schema.json",
  "title": "SPOTCOMP operations profile",
  "type": "object",
  "required": [
    "profileId",
    "stageStrata",
    "workTypes",
    "operationsLoop",
    "processProcedureRecords",
    "ledgerBudgetCost",
    "stationarityLaplacian",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
