{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/cgs-profile.schema.json",
  "title": "SPOTCOMP CGS embedding profile",
  "type": "object",
  "required": ["profileId", "status", "evidence", "arena", "strategies"],
  "additionalProperties": false,
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["candidate", "open", "proved"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "arena": {
      "type": "object",
      "required": ["events"],
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "minimalConflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflictPair" },
          "uniqueItems": true
        },
        "symmetryClasses": {
          "type": "array",
          "items": { "$ref": "#/$defs/symmetryClass" },
          "uniqueItems": true
        }
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategy" }
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "kind", "polarity", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "trace-append",
            "observe-frontier",
            "settle-frontier",
            "federate-delivery",
            "governance-check",
            "actuate-tool",
            "open"
          ]
        },
        "polarity": {
          "enum": ["player", "opponent"]
        },
        "actor": { "type": "string", "minLength": 1 },
        "causes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "traceRows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "frontier": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "symmetryClass": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "conflictPair": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "symmetryClass": {
      "type": "object",
      "required": ["id", "preserves", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "preserves": {
          "type": "array",
          "items": {
            "enum": ["causality", "conflict", "polarity", "trace-identity", "governance"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "playerId",
        "strategyClass",
        "observes",
        "acts",
        "handedness",
        "governance",
        "localSettling",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "strategyClass": {
          "enum": ["concurrent", "deterministic-concurrent", "sequential-innocent", "open"]
        },
        "observes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "acts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "maxConcurrentPlayerMoves": {
          "type": "integer",
          "minimum": 0
        },
        "handedness": {
          "type": "object",
          "required": ["recv", "send", "actuate", "observe"],
          "additionalProperties": false,
          "properties": {
            "recv": { "type": "string", "minLength": 1 },
            "send": { "type": "string", "minLength": 1 },
            "actuate": { "type": "string", "minLength": 1 },
            "observe": { "type": "string", "minLength": 1 }
          }
        },
        "governance": { "type": "string", "minLength": 1 },
        "localSettling": { "type": "string", "minLength": 1 },
        "receptivityClaim": { "type": "string", "minLength": 1 },
        "symmetryQuotient": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
