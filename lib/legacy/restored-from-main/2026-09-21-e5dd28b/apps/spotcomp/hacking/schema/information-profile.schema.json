{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/information-profile.schema.json",
  "title": "SPOTCOMP settling-to-information profile",
  "type": "object",
  "required": ["profileId", "status", "evidence", "scopes", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "open", "proved"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scope" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "aboutnessClosures": {
      "type": "array",
      "items": { "$ref": "#/$defs/aboutnessClosure" }
    },
    "shpProjections": {
      "type": "array",
      "items": { "$ref": "#/$defs/shpProjection" }
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "id",
        "predicateVocabulary",
        "closureRules",
        "entities",
        "consistencyCommitment",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "predicateVocabulary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "closureRules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "entities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "consistencyCommitment": {
          "enum": ["reject-contestation", "tolerate-contestation", "open"]
        },
        "regime": {
          "enum": ["strict", "scott-continuous", "transfinite-bounded", "aperiodic", "open"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "receiver",
        "scope",
        "settlement",
        "uncertaintyReduction",
        "aboutness",
        "provenance",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["settled-information", "document", "record", "witness", "derived-assertion", "projection-source"]
        },
        "receiver": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "settlement": {
          "type": "object",
          "required": ["regime", "ruleSystem", "frontier"],
          "additionalProperties": false,
          "properties": {
            "regime": {
              "enum": ["strict", "scott-continuous", "transfinite-bounded", "aperiodic", "open"]
            },
            "ruleSystem": { "type": "string", "minLength": 1 },
            "frontier": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "stateKind": {
              "enum": ["settled", "provisional", "open"]
            }
          }
        },
        "uncertaintyReduction": {
          "type": "object",
          "required": ["question", "beforeState", "afterState", "evidence"],
          "additionalProperties": false,
          "properties": {
            "question": { "type": "string", "minLength": 1 },
            "beforeState": { "type": "string", "minLength": 1 },
            "afterState": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "aboutness": {
          "type": "array",
          "items": { "$ref": "#/$defs/aboutness" },
          "minItems": 1
        },
        "provenance": {
          "type": "object",
          "required": ["source", "producer", "history", "evidence"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "producer": { "type": "string", "minLength": 1 },
            "history": { "type": "string", "minLength": 1 },
            "preservationPurpose": { "type": "string", "minLength": 1 },
            "arrangement": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "aboutness": {
      "type": "object",
      "required": ["id", "entity", "predicate", "participation", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "participation": {
          "enum": ["subject", "object", "subject-and-object"]
        },
        "value": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "aboutnessClosure": {
      "type": "object",
      "required": ["artifact", "sourceAboutness", "derivedEntity", "morphism", "evidence"],
      "additionalProperties": false,
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "sourceAboutness": { "type": "string", "minLength": 1 },
        "derivedEntity": { "type": "string", "minLength": 1 },
        "morphism": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "shpProjection": {
      "type": "object",
      "required": [
        "id",
        "sourceArtifact",
        "sourceFrontier",
        "projectionMorphism",
        "targetKind",
        "finiteSettlementEvidence",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceArtifact": { "type": "string", "minLength": 1 },
        "sourceFrontier": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "projectionMorphism": { "type": "string", "minLength": 1 },
        "targetKind": { "enum": ["semantic-hypertext-packet"] },
        "finiteSettlementEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
