{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/envelope.schema.json",
  "title": "SPOTCOMP federation envelope",
  "type": "object",
  "required": ["profile", "sender", "keyId", "created", "nonce", "rows", "signature"],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "spotcomp-eavt-envelope-v1"
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://experimental.561.group/spotcomp/schema/eavt-row.schema.json"
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  }
}

