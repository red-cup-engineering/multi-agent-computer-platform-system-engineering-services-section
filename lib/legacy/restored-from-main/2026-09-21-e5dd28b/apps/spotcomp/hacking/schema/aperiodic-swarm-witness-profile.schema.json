{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spotcomp/aperiodic-swarm-witness-profile.schema.json",
  "title": "SPOTCOMP Aperiodic Swarm Witness Profile",
  "type": "object",
  "required": [
    "profileId",
    "settlingWitness",
    "substitutionWitness",
    "directLimitWitness",
    "mldWitness",
    "bigradedInvariantWitness",
    "bilatticeAlignment",
    "weightedSwarmBoundary",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
