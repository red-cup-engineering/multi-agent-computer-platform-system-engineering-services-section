{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/projection.schema.json",
  "title": "SPOTCOMP projection record",
  "type": "object",
  "required": ["id", "sourceTrace", "frontier", "ruleSet", "target"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceTrace": {
      "type": "string",
      "minLength": 1
    },
    "frontier": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "ruleSet": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "enum": ["shp", "finite-algebra", "index", "audit"]
    },
    "producer": {
      "type": "string"
    }
  }
}

