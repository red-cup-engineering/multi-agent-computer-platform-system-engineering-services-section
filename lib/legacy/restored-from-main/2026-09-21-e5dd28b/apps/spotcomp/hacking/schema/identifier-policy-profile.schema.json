{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/identifier-policy-profile.schema.json",
  "title": "SPOTCOMP identifier policy profile",
  "type": "object",
  "required": [
    "profileId",
    "uriPolicy",
    "iriPolicy",
    "urnPolicy",
    "hashNamePolicy",
    "spotcompBindings",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "uriPolicy": { "$ref": "#/$defs/uriPolicy" },
    "iriPolicy": { "$ref": "#/$defs/iriPolicy" },
    "urnPolicy": { "$ref": "#/$defs/urnPolicy" },
    "hashNamePolicy": { "$ref": "#/$defs/hashNamePolicy" },
    "spotcompBindings": { "$ref": "#/$defs/spotcompBindings" },
    "implementationBoundary": { "$ref": "#/$defs/implementationBoundary" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "uriPolicy": {
      "type": "object",
      "required": [
        "rfc3986",
        "identificationNotDereference",
        "absoluteForCanonicalWireIdentity",
        "relativeReferencesRequireBase",
        "comparisonPolicyDeclared",
        "fragmentParticipationDeclared",
        "schemeSpecificNormalizationDeclared",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rfc3986": { "const": true },
        "identificationNotDereference": { "const": true },
        "absoluteForCanonicalWireIdentity": { "const": true },
        "relativeReferencesRequireBase": { "const": true },
        "comparisonPolicyDeclared": { "const": true },
        "fragmentParticipationDeclared": { "const": true },
        "schemeSpecificNormalizationDeclared": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "iriPolicy": {
      "type": "object",
      "required": [
        "rfc3987",
        "iriUseIsExplicit",
        "iriToUriMappingDeclaredForProtocolSlots",
        "unicodeComparisonPolicyDeclared",
        "noSilentUnicodeNormalization",
        "jsonStringPreservationRespected",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rfc3987": { "const": true },
        "iriUseIsExplicit": { "const": true },
        "iriToUriMappingDeclaredForProtocolSlots": { "const": true },
        "unicodeComparisonPolicyDeclared": { "const": true },
        "noSilentUnicodeNormalization": { "const": true },
        "jsonStringPreservationRespected": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "urnPolicy": {
      "type": "object",
      "required": [
        "rfc8141",
        "urnIsUriScheme",
        "namespaceIdentifierDeclared",
        "namespaceSpecificStringPolicyDeclared",
        "urnEquivalencePolicyDeclared",
        "schemeSpecificPartsOpaqueUnlessKnown",
        "dereferenceOrResolutionPolicyDeclared",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rfc8141": { "const": true },
        "urnIsUriScheme": { "const": true },
        "namespaceIdentifierDeclared": { "const": true },
        "namespaceSpecificStringPolicyDeclared": { "const": true },
        "urnEquivalencePolicyDeclared": { "const": true },
        "schemeSpecificPartsOpaqueUnlessKnown": { "const": true },
        "dereferenceOrResolutionPolicyDeclared": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "hashNamePolicy": {
      "type": "object",
      "required": [
        "rfc6920",
        "rfc4648Base64urlForNiDigest",
        "digestAlgorithmDeclared",
        "hashInputDeclared",
        "digestValueNoPadding",
        "nameDataIntegrityCheckDeclared",
        "notReplacementForCanonicalRowId",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rfc6920": { "const": true },
        "rfc4648Base64urlForNiDigest": { "const": true },
        "digestAlgorithmDeclared": { "const": true },
        "hashInputDeclared": { "const": true },
        "digestValueNoPadding": { "const": true },
        "nameDataIntegrityCheckDeclared": { "const": true },
        "notReplacementForCanonicalRowId": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "spotcompBindings": {
      "type": "object",
      "required": [
        "eavtEntityAttributeMayUseLocalSlug",
        "federationRequiresStableIdentifierMapping",
        "rowIdUsesCanonicalHashNotIdentifierText",
        "problemTypeUriStable",
        "profileIdentifiersStable",
        "playerTraceKeyIdentifiersStableAtWireBoundary",
        "localSlugsNotWireUriUnlessMapped",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "eavtEntityAttributeMayUseLocalSlug": { "const": true },
        "federationRequiresStableIdentifierMapping": { "const": true },
        "rowIdUsesCanonicalHashNotIdentifierText": { "const": true },
        "problemTypeUriStable": { "const": true },
        "profileIdentifiersStable": { "const": true },
        "playerTraceKeyIdentifiersStableAtWireBoundary": { "const": true },
        "localSlugsNotWireUriUnlessMapped": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "required": [
        "rejectUndeclaredSchemesForStrongWireConformance",
        "doNotDereferenceDuringValidation",
        "doNotUseUriNormalizationAsRowIdentity",
        "doNotTreatDidKeyAsIetfStandard",
        "quarantineIdentifierConfusablesWhenPolicyMissing",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rejectUndeclaredSchemesForStrongWireConformance": { "const": true },
        "doNotDereferenceDuringValidation": { "const": true },
        "doNotUseUriNormalizationAsRowIdentity": { "const": true },
        "doNotTreatDidKeyAsIetfStandard": { "const": true },
        "quarantineIdentifierConfusablesWhenPolicyMissing": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
