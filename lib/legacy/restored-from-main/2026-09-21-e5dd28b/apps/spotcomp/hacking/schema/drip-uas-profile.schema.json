{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spotcomp/drip-uas-profile.schema.json",
  "title": "SPOTCOMP DRIP UAS Profile",
  "type": "object",
  "required": [
    "profileId",
    "rfcInventory",
    "standardsBoundary",
    "detIdentityBinding",
    "broadcastAuthentication",
    "dnsDimeRegistry",
    "spotcompAdmissionBinding",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
