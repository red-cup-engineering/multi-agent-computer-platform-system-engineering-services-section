{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development.561.group/experimental/spotcomp/schema/regime-record.schema.json",
  "title": "SPOTCOMP Regime Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["regime", "ruleSystemId", "closureOrdinalClaim", "evidence"],
  "properties": {
    "regime": {
      "type": "string",
      "enum": ["strict", "scott-continuous", "transfinite-bounded", "aperiodic"]
    },
    "ruleSystemId": {
      "type": "string",
      "minLength": 1
    },
    "closureOrdinalClaim": {
      "type": "string",
      "enum": ["finite", "omega", "countable-transfinite", "omega1-or-above", "unknown"]
    },
    "closureKind": {
      "type": "string",
      "enum": ["quantifier-free", "with-forall-blocks", "non-scott-continuous", "unknown"]
    },
    "endpointStateSufficient": {
      "type": "boolean"
    },
    "trajectoryRequired": {
      "type": "boolean"
    },
    "cohomologyAuditRequired": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "openObligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
