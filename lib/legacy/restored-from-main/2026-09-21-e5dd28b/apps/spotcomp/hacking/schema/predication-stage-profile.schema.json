{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/predication-stage-profile.schema.json",
  "title": "SPOTCOMP predication stage category profile",
  "type": "object",
  "required": [
    "profileId",
    "stageOrder",
    "stages",
    "direction",
    "finiteBoundary",
    "prelocutionaryBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "stageOrder": {
      "type": "array",
      "prefixItems": [
        { "const": "articulating" },
        { "const": "predicating" },
        { "const": "positing" },
        { "const": "settling" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" },
      "minItems": 4,
      "maxItems": 4
    },
    "direction": { "$ref": "#/$defs/direction" },
    "finiteBoundary": { "$ref": "#/$defs/finiteBoundary" },
    "prelocutionaryBoundary": { "$ref": "#/$defs/prelocutionaryBoundary" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "stage": {
      "type": "object",
      "required": [
        "name",
        "categoryReading",
        "regime",
        "generatorKind",
        "inputBoundary",
        "codomainBoundary",
        "forbids",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["articulating", "predicating", "positing", "settling"] },
        "categoryReading": {
          "enum": [
            "aperiodic-predication-category",
            "transfinite-predication-category",
            "scott-continuous-predication-category",
            "finite-predication-category"
          ]
        },
        "regime": { "enum": ["aperiodic", "transfinite", "scott-continuous", "finite"] },
        "generatorKind": {
          "enum": [
            "aperiodic-predication-generator",
            "transfinite-homotopy-generator",
            "scott-continuous-category-generator",
            "finite-algebra-generator"
          ]
        },
        "inputBoundary": { "type": "string", "minLength": 1 },
        "codomainBoundary": { "type": "string", "minLength": 1 },
        "forbids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "direction": {
      "type": "object",
      "required": [
        "categoryOrder",
        "regimeOrder",
        "downstreamOnly",
        "finiteDoesNotDefineUpstream",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "categoryOrder": { "const": "articulating -> predicating -> positing -> settling" },
        "regimeOrder": { "const": "aperiodic -> transfinite -> scott-continuous -> finite" },
        "downstreamOnly": { "const": true },
        "finiteDoesNotDefineUpstream": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "finiteBoundary": {
      "type": "object",
      "required": [
        "fourPlacement",
        "fourSpecializationOnly",
        "finiteArtifactsDownstream",
        "shpFiniteProjection",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "fourPlacement": { "const": "settling-finite-predication-category" },
        "fourSpecializationOnly": { "const": true },
        "finiteArtifactsDownstream": { "const": true },
        "shpFiniteProjection": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "prelocutionaryBoundary": {
      "type": "object",
      "required": [
        "environmentalDecodingDoesNotChooseStage",
        "typedInputDeclaresStage",
        "illocutionRequiresPositingStage",
        "perlocutionRequiresSettlingStage",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "environmentalDecodingDoesNotChooseStage": { "const": true },
        "typedInputDeclaresStage": { "const": true },
        "illocutionRequiresPositingStage": { "const": true },
        "perlocutionRequiresSettlingStage": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
