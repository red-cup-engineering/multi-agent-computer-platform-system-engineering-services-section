{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/operations-records.schema.json",
  "title": "SPOTCOMP operations records bundle",
  "type": "object",
  "required": [
    "profileId",
    "evidence",
    "processRecords",
    "procedureRecords",
    "workEvents",
    "budgets",
    "ledgerPostings",
    "costEvents",
    "operationsLoops",
    "implementationBoundary"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
    "processRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "procedureRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "workEvents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "ledgerPostings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "costEvents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "operationsLoops": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectRecord" }
    },
    "implementationBoundary": {
      "type": "object",
      "required": ["evidence"],
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "evidence": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "objectRecord": {
      "type": "object",
      "required": ["id", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": true
    }
  }
}
