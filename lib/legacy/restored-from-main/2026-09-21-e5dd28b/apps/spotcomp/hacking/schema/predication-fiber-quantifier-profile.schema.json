{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/predication-fiber-quantifier-profile.schema.json",
  "title": "SPOTCOMP predication fiber quantifier profile",
  "type": "object",
  "required": [
    "profileId",
    "evidence",
    "reindexing",
    "existential",
    "universal",
    "orderSeparation",
    "probeBoundary"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
    "reindexing": { "$ref": "#/$defs/section" },
    "existential": { "$ref": "#/$defs/section" },
    "universal": { "$ref": "#/$defs/section" },
    "orderSeparation": { "$ref": "#/$defs/section" },
    "probeBoundary": { "$ref": "#/$defs/section" }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "section": {
      "type": "object",
      "required": ["evidence"],
      "properties": {
        "evidence": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": true
    }
  }
}
