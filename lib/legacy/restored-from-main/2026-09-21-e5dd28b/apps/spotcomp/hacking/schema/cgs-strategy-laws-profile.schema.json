{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/cgs-strategy-laws-profile.schema.json",
  "title": "SPOTCOMP CGS strategy laws profile",
  "type": "object",
  "required": [
    "profileId",
    "objectBoundary",
    "morphismBoundary",
    "compositionBoundary",
    "restrictionBoundary",
    "swarmBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "objectBoundary": { "$ref": "#/$defs/objectBoundary" },
    "morphismBoundary": { "$ref": "#/$defs/morphismBoundary" },
    "compositionBoundary": { "$ref": "#/$defs/compositionBoundary" },
    "restrictionBoundary": { "$ref": "#/$defs/restrictionBoundary" },
    "swarmBoundary": { "$ref": "#/$defs/swarmBoundary" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "objectBoundary": {
      "type": "object",
      "required": [
        "primeEventStructureRequired",
        "minimalConflictGeneratesInheritedConflict",
        "conflictInheritanceRequired",
        "polarityAdditionalToEventStructure",
        "polarityNotPlayerIdentity",
        "symmetryGroupoidPreservesCausalityConflictPolarity",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "primeEventStructureRequired": { "const": true },
        "minimalConflictGeneratesInheritedConflict": { "const": true },
        "conflictInheritanceRequired": { "const": true },
        "polarityAdditionalToEventStructure": { "const": true },
        "polarityNotPlayerIdentity": { "const": true },
        "symmetryGroupoidPreservesCausalityConflictPolarity": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "morphismBoundary": {
      "type": "object",
      "required": [
        "arenaFormula",
        "dualizesDomainPolarity",
        "strategyMapFromEventStructure",
        "quotientBySymmetryGroupoid",
        "receptiveToOpponentExtensions",
        "noPlayerSequentializationRequired",
        "causalityPreserving",
        "conflictPreserving",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "arenaFormula": { "const": "A^perp || B" },
        "dualizesDomainPolarity": { "const": true },
        "strategyMapFromEventStructure": { "const": true },
        "quotientBySymmetryGroupoid": { "const": true },
        "receptiveToOpponentExtensions": { "const": true },
        "noPlayerSequentializationRequired": { "const": true },
        "causalityPreserving": { "const": true },
        "conflictPreserving": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "compositionBoundary": {
      "type": "object",
      "required": [
        "compositionIsInteractionAndHiding",
        "parallelInteractionOverSharedInterface",
        "intermediateMovesHidden",
        "associativeUpToCanonicalIsomorphism",
        "wellDefinedRequiresReceptivity",
        "wellDefinedRequiresCausalityPreservation",
        "wellDefinedRequiresConflictPreservation",
        "notTraceConcatenation",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "compositionIsInteractionAndHiding": { "const": true },
        "parallelInteractionOverSharedInterface": { "const": true },
        "intermediateMovesHidden": { "const": true },
        "associativeUpToCanonicalIsomorphism": { "const": true },
        "wellDefinedRequiresReceptivity": { "const": true },
        "wellDefinedRequiresCausalityPreservation": { "const": true },
        "wellDefinedRequiresConflictPreservation": { "const": true },
        "notTraceConcatenation": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "restrictionBoundary": {
      "type": "object",
      "required": [
        "sequentialIsRestrictionOfConcurrent",
        "innocentIsRestrictionOfConcurrent",
        "deterministicConcurrentAtMostOnePlayerMove",
        "innocenceRequiresPlayerViewDependence",
        "innocenceRequiresFiniteViewActionEvidence",
        "fullFaithfulEmbeddingOnlyAsRestriction",
        "generalSwarmModelAllowsConcurrentPlayerMoves",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "sequentialIsRestrictionOfConcurrent": { "const": true },
        "innocentIsRestrictionOfConcurrent": { "const": true },
        "deterministicConcurrentAtMostOnePlayerMove": { "const": true },
        "innocenceRequiresPlayerViewDependence": { "const": true },
        "innocenceRequiresFiniteViewActionEvidence": { "const": true },
        "fullFaithfulEmbeddingOnlyAsRestriction": { "const": true },
        "generalSwarmModelAllowsConcurrentPlayerMoves": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "swarmBoundary": {
      "type": "object",
      "required": [
        "strategyEquivalenceNotKeyIdentity",
        "strategyEquivalenceNotTraceLoopEquality",
        "localObservationViewsRequired",
        "playerActionsMayBeConcurrent",
        "traceMergeRespectingSymmetryRemainsOpen",
        "unknownStrategyLawsBlockStrongSwarmConformance",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "strategyEquivalenceNotKeyIdentity": { "const": true },
        "strategyEquivalenceNotTraceLoopEquality": { "const": true },
        "localObservationViewsRequired": { "const": true },
        "playerActionsMayBeConcurrent": { "const": true },
        "traceMergeRespectingSymmetryRemainsOpen": { "const": true },
        "unknownStrategyLawsBlockStrongSwarmConformance": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
