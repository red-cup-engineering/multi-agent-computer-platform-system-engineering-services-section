{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development.561.group/experimental/spotcomp/schema/path-role.schema.json",
  "title": "SPOTCOMP Path Role Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "role", "status", "evidence"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the catalog root."
    },
    "role": {
      "type": "string",
      "enum": [
        "catalog-root",
        "category-root",
        "generator",
        "codomain-object",
        "schema-witness",
        "trace-log",
        "script-witness",
        "projection-artifact",
        "support-artifact"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proved", "candidate", "open", "rejected"]
    },
    "thingSlug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "parentCategory": {
      "type": "string",
      "description": "Relative path of the category root this role depends on."
    },
    "generator": {
      "type": "string",
      "description": "Relative path or slug of the generator producing this object."
    },
    "domain": {
      "type": "string",
      "description": "Relative path or declared object for a generator domain."
    },
    "codomain": {
      "type": "string",
      "description": "Relative path or declared object for a generator codomain."
    },
    "generatorVariance": {
      "type": "string",
      "enum": ["extension", "restriction", "coincidence", "unknown"]
    },
    "schemaPath": {
      "type": "string"
    },
    "traceLogPath": {
      "type": "string"
    },
    "scriptPath": {
      "type": "string"
    },
    "sourceFrontier": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "projectionMorphism": {
      "type": "string"
    },
    "authoritative": {
      "type": "boolean",
      "description": "False for support artifacts and secondary caches."
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "generator" } }, "required": ["role"] },
      "then": { "required": ["domain", "codomain", "generatorVariance"] }
    },
    {
      "if": { "properties": { "role": { "const": "codomain-object" } }, "required": ["role"] },
      "then": { "anyOf": [{ "required": ["generator"] }, { "required": ["openObligations"] }] }
    },
    {
      "if": { "properties": { "role": { "const": "schema-witness" } }, "required": ["role"] },
      "then": { "required": ["thingSlug", "schemaPath"] }
    },
    {
      "if": { "properties": { "role": { "const": "trace-log" } }, "required": ["role"] },
      "then": { "required": ["thingSlug", "traceLogPath"] }
    },
    {
      "if": { "properties": { "role": { "const": "script-witness" } }, "required": ["role"] },
      "then": { "required": ["thingSlug", "scriptPath"] }
    },
    {
      "if": { "properties": { "role": { "const": "projection-artifact" } }, "required": ["role"] },
      "then": { "required": ["sourceFrontier", "projectionMorphism"] }
    },
    {
      "if": { "properties": { "role": { "const": "support-artifact" } }, "required": ["role"] },
      "then": { "required": ["authoritative"], "properties": { "authoritative": { "const": false } } }
    }
  ]
}
