{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development.561.group/experimental/spotcomp/schema/federation-profile.schema.json",
  "title": "SPOTCOMP Regime Federation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "regime", "payloadKind", "downgradeBehavior", "evidence"],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "regime": {
      "$ref": "https://development.561.group/experimental/spotcomp/schema/regime-record.schema.json"
    },
    "payloadKind": {
      "type": "string",
      "enum": ["trace-increment", "endpoint-state", "trajectory-prefix", "cohomology-audit", "projection-artifact"]
    },
    "frontier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "trajectory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cohomologyAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designationGrades": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "uniqueItems": true
        },
        "cohomologicalDegrees": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "continuityEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "downgradeBehavior": {
      "type": "string",
      "enum": ["reject", "accept-as-trace-only", "accept-as-informative-projection"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
