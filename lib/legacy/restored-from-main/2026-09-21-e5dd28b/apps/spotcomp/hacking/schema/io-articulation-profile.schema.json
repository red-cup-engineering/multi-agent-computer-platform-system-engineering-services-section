{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/io-articulation-profile.schema.json",
  "title": "SPOTCOMP I/O articulation declaration",
  "type": "object",
  "required": [
    "profileId",
    "ioBoundary",
    "articulatingGate",
    "llmBoundary",
    "partialityBoundary",
    "standardsBoundary",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "ioBoundary": { "$ref": "#/$defs/section" },
    "articulatingGate": { "$ref": "#/$defs/section" },
    "llmBoundary": { "$ref": "#/$defs/section" },
    "partialityBoundary": { "$ref": "#/$defs/section" },
    "standardsBoundary": { "$ref": "#/$defs/section" },
    "implementationBoundary": { "$ref": "#/$defs/section" },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["evidence"],
      "additionalProperties": {
        "anyOf": [
          { "type": "boolean" },
          {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        ]
      },
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
