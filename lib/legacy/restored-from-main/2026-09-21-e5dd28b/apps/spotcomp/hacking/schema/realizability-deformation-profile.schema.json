{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spotcomp/realizability-deformation-profile.schema.json",
  "title": "SPOTCOMP Realizability Deformation Profile",
  "type": "object",
  "required": [
    "profileId",
    "metaRealizabilityMap",
    "realizabilityAxes",
    "predicateNaturalityCoupling",
    "deformationTangent",
    "chlStabilization",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
