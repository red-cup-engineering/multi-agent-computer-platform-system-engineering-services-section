{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/recognition-profile.schema.json",
  "title": "SPOTCOMP recognition profile",
  "type": "object",
  "required": [
    "profileId",
    "recognitionBoundary",
    "traceRecognitionAxis",
    "admissionPolicy",
    "swarmRecognition",
    "cgsAdmission",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "recognitionBoundary": { "$ref": "#/$defs/recognitionBoundary" },
    "traceRecognitionAxis": { "$ref": "#/$defs/traceRecognitionAxis" },
    "admissionPolicy": { "$ref": "#/$defs/admissionPolicy" },
    "swarmRecognition": { "$ref": "#/$defs/swarmRecognition" },
    "cgsAdmission": { "$ref": "#/$defs/cgsAdmission" },
    "implementationBoundary": { "$ref": "#/$defs/implementationBoundary" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "recognitionBoundary": {
      "type": "object",
      "required": [
        "recognitionIsTraceAxis",
        "finiteRowsDoNotCarryRecognitionInline",
        "recognitionHasSeparateResourceOrProjection",
        "shapeRecognitionIsCarrierCheckOnly",
        "mathematicalRecognitionRequiresSettlement",
        "aliasRecognitionNeedsScopedTheorem",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "recognitionIsTraceAxis": { "const": true },
        "finiteRowsDoNotCarryRecognitionInline": { "const": true },
        "recognitionHasSeparateResourceOrProjection": { "const": true },
        "shapeRecognitionIsCarrierCheckOnly": { "const": true },
        "mathematicalRecognitionRequiresSettlement": { "const": true },
        "aliasRecognitionNeedsScopedTheorem": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "traceRecognitionAxis": {
      "type": "object",
      "required": [
        "axisName",
        "preservedByDeclaredResource",
        "forgottenByFiniteRowProjectionUnlessDeclared",
        "receiverRelative",
        "connectsToInformationObservation",
        "connectsToSwarmAdmission",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "axisName": { "const": "recognition-fiber" },
        "preservedByDeclaredResource": { "const": true },
        "forgottenByFiniteRowProjectionUnlessDeclared": { "const": true },
        "receiverRelative": { "const": true },
        "connectsToInformationObservation": { "const": true },
        "connectsToSwarmAdmission": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "admissionPolicy": {
      "type": "object",
      "required": [
        "signatureVerificationBeforeFederationAdmission",
        "canonicalIdentityBeforeMerge",
        "governanceBeforeSideEffectAdmission",
        "capabilityBoundsBeforeActionAdmission",
        "observationBoundsBeforeMoveAdmission",
        "typedShapeRecognitionBeforeSettlementClaim",
        "dualFilingBeforeLocalAdmission",
        "failedRecognitionDowngradesOrRejects",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "signatureVerificationBeforeFederationAdmission": { "const": true },
        "canonicalIdentityBeforeMerge": { "const": true },
        "governanceBeforeSideEffectAdmission": { "const": true },
        "capabilityBoundsBeforeActionAdmission": { "const": true },
        "observationBoundsBeforeMoveAdmission": { "const": true },
        "typedShapeRecognitionBeforeSettlementClaim": { "const": true },
        "dualFilingBeforeLocalAdmission": { "const": true },
        "failedRecognitionDowngradesOrRejects": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "swarmRecognition": {
      "type": "object",
      "required": [
        "rolesDerivedFromRecognitionCellsAndGovernance",
        "leaderNotOutOfBand",
        "validatorNotOutOfBand",
        "participantsReferenceModeledPlayers",
        "sharedTraceIsAdmittedTrace",
        "recognitionDisciplineDeclared",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rolesDerivedFromRecognitionCellsAndGovernance": { "const": true },
        "leaderNotOutOfBand": { "const": true },
        "validatorNotOutOfBand": { "const": true },
        "participantsReferenceModeledPlayers": { "const": true },
        "sharedTraceIsAdmittedTrace": { "const": true },
        "recognitionDisciplineDeclared": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "cgsAdmission": {
      "type": "object",
      "required": [
        "admittedFederateDeliveryRequiresVerificationAndGovernance",
        "admittedMoveRequiresObservationActionCapabilityBounds",
        "rejectedAdmissionsCanSupplyConflictEvidence",
        "observationMapsArePlayerLocal",
        "polarityNotIdentity",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "admittedFederateDeliveryRequiresVerificationAndGovernance": { "const": true },
        "admittedMoveRequiresObservationActionCapabilityBounds": { "const": true },
        "rejectedAdmissionsCanSupplyConflictEvidence": { "const": true },
        "observationMapsArePlayerLocal": { "const": true },
        "polarityNotIdentity": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "required": [
        "doNotTreatParseSuccessAsRecognitionFiber",
        "doNotTreatRowPresenceAsAdmission",
        "doNotInferRolesFromFlagsOnly",
        "recordRecognitionEvidenceRows",
        "separateShapeRecognitionFromMathematicalRecognition",
        "unknownRecognitionBlocksStrongSwarmConformance",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "doNotTreatParseSuccessAsRecognitionFiber": { "const": true },
        "doNotTreatRowPresenceAsAdmission": { "const": true },
        "doNotInferRolesFromFlagsOnly": { "const": true },
        "recordRecognitionEvidenceRows": { "const": true },
        "separateShapeRecognitionFromMathematicalRecognition": { "const": true },
        "unknownRecognitionBlocksStrongSwarmConformance": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
