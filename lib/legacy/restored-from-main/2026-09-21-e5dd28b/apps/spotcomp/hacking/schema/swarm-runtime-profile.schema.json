{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/swarm-runtime-profile.schema.json",
  "title": "SPOTCOMP swarm runtime profile declaration",
  "type": "object",
  "required": [
    "profileId",
    "evidence",
    "derivationDirection",
    "swarmObject",
    "federationAdmission",
    "traceStore",
    "playerLocalLoop",
    "modeledPlayerState",
    "cgsLudicHandoff",
    "settlementProjectionPackets",
    "operationsGovernanceCost",
    "bigradedAperiodic",
    "standardsBoundary",
    "nonConformanceBoundary"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
    "derivationDirection": {
      "type": "array",
      "prefixItems": [
        { "const": "aperiodic-articulating" },
        { "const": "transfinite-predicating" },
        { "const": "scott-continuous-positing" },
        { "const": "finite-settling" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "swarmObject": { "$ref": "#/$defs/section" },
    "federationAdmission": { "$ref": "#/$defs/section" },
    "traceStore": { "$ref": "#/$defs/section" },
    "playerLocalLoop": { "$ref": "#/$defs/section" },
    "modeledPlayerState": { "$ref": "#/$defs/section" },
    "cgsLudicHandoff": { "$ref": "#/$defs/section" },
    "settlementProjectionPackets": { "$ref": "#/$defs/section" },
    "operationsGovernanceCost": { "$ref": "#/$defs/section" },
    "bigradedAperiodic": { "$ref": "#/$defs/section" },
    "standardsBoundary": { "$ref": "#/$defs/section" },
    "nonConformanceBoundary": { "$ref": "#/$defs/section" }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "section": {
      "type": "object",
      "required": ["evidence"],
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "evidence": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  }
}
