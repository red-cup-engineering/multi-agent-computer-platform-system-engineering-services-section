{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/canonical-identity-profile.schema.json",
  "title": "SPOTCOMP canonical identity profile",
  "type": "object",
  "required": [
    "profileId",
    "rowIdentity",
    "jsonPreconditions",
    "signatureInput",
    "streamIdentity",
    "timestampPolicy",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "rowIdentity": { "$ref": "#/$defs/rowIdentity" },
    "jsonPreconditions": { "$ref": "#/$defs/jsonPreconditions" },
    "signatureInput": { "$ref": "#/$defs/signatureInput" },
    "streamIdentity": { "$ref": "#/$defs/streamIdentity" },
    "timestampPolicy": { "$ref": "#/$defs/timestampPolicy" },
    "implementationBoundary": { "$ref": "#/$defs/implementationBoundary" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "rowIdentity": {
      "type": "object",
      "required": [
        "rowShape",
        "canonicalization",
        "hashAlgorithm",
        "identityFormula",
        "memberOrderIndependent",
        "linePositionNonAuthoritative",
        "arrayOrderPreserved",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rowShape": { "const": "exact-eavt" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "hashAlgorithm": { "const": "SHA-256" },
        "identityFormula": { "const": "sha256(jcs(row))" },
        "memberOrderIndependent": { "const": true },
        "linePositionNonAuthoritative": { "const": true },
        "arrayOrderPreserved": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "jsonPreconditions": {
      "type": "object",
      "required": [
        "jsonSyntaxRfc",
        "ijsonRfc",
        "jcsRfc",
        "duplicateNamesRejected",
        "unicodeStringsPreserved",
        "unicodeNormalizationForbidden",
        "numbersFinite",
        "largeExactNumbersAsStrings",
        "canonicalWhitespaceForbidden",
        "recursiveObjectSort",
        "arrayOrderNotChanged",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonSyntaxRfc": { "const": "RFC8259" },
        "ijsonRfc": { "const": "RFC7493" },
        "jcsRfc": { "const": "RFC8785" },
        "duplicateNamesRejected": { "const": true },
        "unicodeStringsPreserved": { "const": true },
        "unicodeNormalizationForbidden": { "const": true },
        "numbersFinite": { "const": true },
        "largeExactNumbersAsStrings": { "const": true },
        "canonicalWhitespaceForbidden": { "const": true },
        "recursiveObjectSort": { "const": true },
        "arrayOrderNotChanged": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "signatureInput": {
      "type": "object",
      "required": [
        "signatureAlgorithm",
        "signatureRfc",
        "canonicalizeUnsignedEnvelope",
        "removeSignatureMemberBeforeSigning",
        "verifyBeforeMerge",
        "scopeIncludesSenderKeyCreatedNonceProfileRows",
        "rejectIfCanonicalBytesNotReproducible",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "signatureAlgorithm": { "const": "Ed25519" },
        "signatureRfc": { "const": "RFC8032" },
        "canonicalizeUnsignedEnvelope": { "const": true },
        "removeSignatureMemberBeforeSigning": { "const": true },
        "verifyBeforeMerge": { "const": true },
        "scopeIncludesSenderKeyCreatedNonceProfileRows": { "const": true },
        "rejectIfCanonicalBytesNotReproducible": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "streamIdentity": {
      "type": "object",
      "required": [
        "jsonlOnDiskOnly",
        "networkSequenceRfc",
        "networkSequenceMediaType",
        "sequenceHasNoCanonicalForm",
        "signItemsOrManifest",
        "itemIdentityByCanonicalRowId",
        "utf8Required",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonlOnDiskOnly": { "const": true },
        "networkSequenceRfc": { "const": "RFC7464" },
        "networkSequenceMediaType": { "const": "application/json-seq" },
        "sequenceHasNoCanonicalForm": { "const": true },
        "signItemsOrManifest": { "const": true },
        "itemIdentityByCanonicalRowId": { "const": true },
        "utf8Required": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "timestampPolicy": {
      "type": "object",
      "required": [
        "timestampRfc",
        "profile",
        "uppercaseTAndZ",
        "timezoneExplicit",
        "timestampsNotMergeAuthority",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "timestampRfc": { "const": "RFC3339" },
        "profile": { "const": "Internet date/time" },
        "uppercaseTAndZ": { "const": true },
        "timezoneExplicit": { "const": true },
        "timestampsNotMergeAuthority": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "required": [
        "duplicateDetectingParserRequiredForStrongImport",
        "postParseObjectCannotProveNoDuplicates",
        "canonicalizerMustBeJcsConformant",
        "currentProbeNotFullJcsImplementation",
        "canonicalizationFailureRejectsOrQuarantines",
        "rowIdStableAcrossObjectMemberOrder",
        "rowIdChangesWithValueChange",
        "mergeUsesCanonicalRowId",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "duplicateDetectingParserRequiredForStrongImport": { "const": true },
        "postParseObjectCannotProveNoDuplicates": { "const": true },
        "canonicalizerMustBeJcsConformant": { "const": true },
        "currentProbeNotFullJcsImplementation": { "const": true },
        "canonicalizationFailureRejectsOrQuarantines": { "const": true },
        "rowIdStableAcrossObjectMemberOrder": { "const": true },
        "rowIdChangesWithValueChange": { "const": true },
        "mergeUsesCanonicalRowId": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}

