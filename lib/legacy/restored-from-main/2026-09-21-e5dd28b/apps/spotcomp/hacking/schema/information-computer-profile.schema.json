{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/information-computer-profile.schema.json",
  "title": "SPOTCOMP information-to-computer profile",
  "type": "object",
  "required": ["profileId", "status", "evidence", "sourceArtifacts", "resources", "carriers"],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "open", "proved"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "carriers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/carrier" }
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sourceArtifact": {
      "type": "object",
      "required": ["id", "informationProfile", "artifact", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "informationProfile": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "role",
        "realizes",
        "schemaWitness",
        "logWitness",
        "witnessTriad",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["fiber", "object-slice", "morphism", "projection", "support"]
        },
        "realizes": { "type": "string", "minLength": 1 },
        "schemaWitness": { "$ref": "#/$defs/schemaWitness" },
        "logWitness": { "$ref": "#/$defs/logWitness" },
        "scriptWitness": { "$ref": "#/$defs/scriptWitness" },
        "witnessTriad": {
          "type": "object",
          "required": ["coLocated", "schemaTypesLog", "logInhabitsType"],
          "additionalProperties": false,
          "properties": {
            "coLocated": { "type": "boolean" },
            "schemaTypesLog": { "type": "boolean" },
            "logInhabitsType": { "type": "boolean" },
            "scriptIsMorphism": { "type": "boolean" }
          }
        },
        "valueIndex": {
          "type": "object",
          "required": ["authoritative"],
          "additionalProperties": false,
          "properties": {
            "authoritative": { "type": "boolean" },
            "purpose": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "schemaWitness": {
      "type": "object",
      "required": ["path", "declaresType", "additionalPropertiesFalse", "evidence"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "declaresType": { "type": "string", "minLength": 1 },
        "additionalPropertiesFalse": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "logWitness": {
      "type": "object",
      "required": ["path", "carrier", "appendOnly", "fiberRealization", "evidence"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "carrier": { "type": "string", "minLength": 1 },
        "appendOnly": { "type": "boolean" },
        "fiberRealization": { "type": "boolean" },
        "federable": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "scriptWitness": {
      "type": "object",
      "required": ["path", "defaultExport", "monotone", "evidence"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "defaultExport": { "type": "boolean" },
        "monotone": { "type": "boolean" },
        "sideEffectBound": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "carrier": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "rowFields",
        "valueFieldRole",
        "appendOnly",
        "canonicalIdentity",
        "contentAddressing",
        "merge",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["eavt-trace-log", "open"] },
        "rowFields": {
          "type": "array",
          "items": { "enum": ["e", "a", "v", "t"] },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "valueFieldRole": {
          "enum": ["object-coordinate"]
        },
        "appendOnly": { "type": "boolean" },
        "canonicalIdentity": {
          "enum": ["canonical-json-sha256", "open"]
        },
        "contentAddressing": { "type": "boolean" },
        "merge": {
          "enum": ["g-set-union", "open"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
