{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/swarm.schema.json",
  "title": "SPOTCOMP swarm",
  "type": "object",
  "required": ["id", "players", "sharedTrace"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "players": {
      "type": "array",
      "items": {
        "$ref": "https://experimental.561.group/spotcomp/schema/player.schema.json"
      },
      "uniqueItems": true
    },
    "sharedTrace": {
      "type": "string",
      "description": "Trace identifier for the admitted shared trace."
    },
    "governance": {
      "type": "string"
    },
    "settlementProfiles": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}

