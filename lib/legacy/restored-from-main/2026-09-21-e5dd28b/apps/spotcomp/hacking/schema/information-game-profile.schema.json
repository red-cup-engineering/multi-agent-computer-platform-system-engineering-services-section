{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/information-game-profile.schema.json",
  "title": "SPOTCOMP information-to-game profile",
  "type": "object",
  "required": [
    "profileId",
    "status",
    "evidence",
    "polarityRule",
    "informationObjects",
    "observationMaps",
    "arenaBinding",
    "strategyBindings",
    "federationComposition"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "open", "proved"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "polarityRule": {
      "enum": ["game-theoretic-player-opponent"]
    },
    "globalFrontierAssumption": {
      "type": "boolean"
    },
    "informationObjects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/informationObject" }
    },
    "observationMaps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observationMap" }
    },
    "arenaBinding": {
      "type": "object",
      "required": ["cgsProfile", "observeEvents"],
      "additionalProperties": false,
      "properties": {
        "cgsProfile": { "type": "string", "minLength": 1 },
        "observeEvents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["observationMap", "event"],
            "additionalProperties": false,
            "properties": {
              "observationMap": { "type": "string", "minLength": 1 },
              "event": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        },
        "settlementEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["informationObject", "event"],
            "additionalProperties": false,
            "properties": {
              "informationObject": { "type": "string", "minLength": 1 },
              "event": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "strategyBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategyBinding" }
    },
    "federationComposition": {
      "type": "object",
      "required": ["mode", "evidence"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["parallel-composition", "open"]
        },
        "sharedEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "symmetry": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "informationObject": {
      "type": "object",
      "required": [
        "id",
        "receiver",
        "settlement",
        "settledFrontier",
        "aboutness",
        "recognitionFiber",
        "provenance",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "receiver": { "type": "string", "minLength": 1 },
        "settlement": {
          "type": "object",
          "required": ["regime", "ruleSystem"],
          "additionalProperties": false,
          "properties": {
            "regime": {
              "enum": ["strict", "scott-continuous", "transfinite-bounded", "aperiodic", "open"]
            },
            "ruleSystem": { "type": "string", "minLength": 1 },
            "frontierKind": { "type": "string", "minLength": 1 }
          }
        },
        "settledFrontier": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "aboutness": {
          "type": "array",
          "items": { "$ref": "#/$defs/aboutness" },
          "minItems": 1
        },
        "recognitionFiber": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "aboutness": {
      "type": "object",
      "required": ["entity", "predicate", "evidence"],
      "additionalProperties": false,
      "properties": {
        "entity": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "observationMap": {
      "type": "object",
      "required": [
        "id",
        "playerId",
        "sourceInformation",
        "observableFrontier",
        "preservesAxes",
        "forgetsAxes",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "playerId": { "type": "string", "minLength": 1 },
        "sourceInformation": { "type": "string", "minLength": 1 },
        "observableFrontier": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "preservesAxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceAxis" },
          "minItems": 1,
          "uniqueItems": true
        },
        "forgetsAxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceAxis" },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "strategyBinding": {
      "type": "object",
      "required": ["playerId", "observationMap", "strategyId", "actionEvents", "evidence"],
      "additionalProperties": false,
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "observationMap": { "type": "string", "minLength": 1 },
        "strategyId": { "type": "string", "minLength": 1 },
        "actionEvents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "traceAxis": {
      "enum": [
        "events",
        "temporal-causal",
        "evidence-trajectory",
        "recognition-fiber",
        "refinement",
        "provenance",
        "aboutness",
        "frontier"
      ]
    }
  }
}
