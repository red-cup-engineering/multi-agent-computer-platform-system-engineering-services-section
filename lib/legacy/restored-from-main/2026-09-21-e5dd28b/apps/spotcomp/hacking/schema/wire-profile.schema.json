{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/wire-profile.schema.json",
  "title": "SPOTCOMP wire profile declaration",
  "type": "object",
  "required": [
    "profileId",
    "payloadKind",
    "representation",
    "mediaType",
    "registration",
    "transport",
    "requiredRfc",
    "canonicalization",
    "signature",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "payloadKind": {
      "enum": [
        "eavt-envelope",
        "eavt-trace-sequence",
        "problem-detail",
        "shp-packet",
        "regime-record",
        "federation-profile"
      ]
    },
    "representation": {
      "enum": ["json", "json-seq", "html"]
    },
    "mediaType": {
      "type": "string",
      "minLength": 3
    },
    "registration": {
      "enum": ["existing-standard", "candidate-unregistered", "registered", "not-applicable"]
    },
    "transport": {
      "enum": ["http", "filesystem", "both"]
    },
    "requiredRfc": {
      "type": "array",
      "items": {
        "enum": [
          "RFC6838",
          "RFC6839",
          "RFC7464",
          "RFC8032",
          "RFC8259",
          "RFC8410",
          "RFC8785",
          "RFC9110",
          "RFC9457"
        ]
      },
      "uniqueItems": true
    },
    "canonicalization": {
      "enum": ["rfc8785", "none"]
    },
    "signature": {
      "enum": ["ed25519", "none"]
    },
    "signatureInput": {
      "enum": ["canonical-json", "canonical-json-items", "row-id-manifest", "none"]
    },
    "keyEncoding": {
      "enum": ["raw-public-key", "x509-spki", "none"]
    },
    "contentTypeRequired": {
      "type": "boolean"
    },
    "profileParameter": {
      "type": "string",
      "minLength": 1
    },
    "problemTypeBase": {
      "type": "string",
      "format": "uri"
    },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
