{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experimental.561.group/spotcomp/schema/shp-profile.schema.json",
  "title": "SPOTCOMP Semantic Hypertext Packet profile",
  "type": "object",
  "required": [
    "profileId",
    "object",
    "directions",
    "packetGrammar",
    "rfc7992Inhabitant",
    "safety",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "object": { "$ref": "#/$defs/object" },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/direction" }
    },
    "packetGrammar": { "$ref": "#/$defs/packetGrammar" },
    "rfc7992Inhabitant": { "$ref": "#/$defs/rfc7992Inhabitant" },
    "safety": { "$ref": "#/$defs/safety" },
    "openObligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "role",
        "carrier",
        "finite",
        "sourceTrace",
        "traceFrontier",
        "settlementEvidence",
        "projectionMorphism",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "const": "semantic-hypertext-packet" },
        "carrier": { "const": "html-document" },
        "finite": { "const": true },
        "sourceTrace": { "type": "string", "minLength": 1 },
        "traceFrontier": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "settlementEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "projectionMorphism": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "direction": {
      "type": "object",
      "required": ["kind", "inputCarrier", "outputCarrier", "morphism", "deterministic", "monotone", "evidence"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["projection", "markup"] },
        "inputCarrier": { "type": "string", "minLength": 1 },
        "outputCarrier": { "type": "string", "minLength": 1 },
        "morphism": { "type": "string", "minLength": 1 },
        "deterministic": { "const": true },
        "monotone": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "packetGrammar": {
      "type": "object",
      "required": [
        "classNamesAreMorphismIdentities",
        "dataAttributesCarryInputCarrierElements",
        "carrierOfCarriers",
        "alternatePlainTextPacketProfile",
        "carrierAttributes",
        "morphismIdentities",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "classNamesAreMorphismIdentities": { "const": true },
        "dataAttributesCarryInputCarrierElements": { "const": true },
        "carrierOfCarriers": { "const": true },
        "alternatePlainTextPacketProfile": { "const": false },
        "carrierAttributes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^data-[a-z0-9][a-z0-9-]*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "morphismIdentities": {
          "type": "array",
          "items": { "$ref": "#/$defs/morphismIdentity" },
          "minItems": 1
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "morphismIdentity": {
      "type": "object",
      "required": ["className", "morphism", "source", "evidence"],
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "morphism": { "type": "string", "minLength": 1 },
        "source": { "enum": ["spotcomp", "rfc7992"] },
        "carrierAttributes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^data-[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "rfc7992Inhabitant": {
      "type": "object",
      "required": [
        "enabled",
        "status",
        "doctype",
        "rootLang",
        "rootClassSource",
        "charset",
        "lineEndings",
        "attributeQuoting",
        "requiredExternalResources",
        "executableScripts",
        "structuralClasses",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": { "const": true },
        "status": { "const": "inhabitant-profile" },
        "doctype": { "const": "<!DOCTYPE html>" },
        "rootLang": { "const": "en" },
        "rootClassSource": { "const": "seriesInfo" },
        "charset": { "const": "utf-8" },
        "lineEndings": { "const": "LF" },
        "attributeQuoting": { "const": "double" },
        "requiredExternalResources": { "const": false },
        "executableScripts": { "const": false },
        "structuralClasses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "safety": {
      "type": "object",
      "required": ["parseAsUntrusted", "noScriptExecution", "noRequiredExternalResources", "evidence"],
      "additionalProperties": false,
      "properties": {
        "parseAsUntrusted": { "const": true },
        "noScriptExecution": { "const": true },
        "noRequiredExternalResources": { "const": true },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
