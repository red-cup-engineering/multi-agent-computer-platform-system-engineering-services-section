{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/development/experimental/spotcomp/schema/continuous-learning-profile.schema.json",
  "title": "SPOTCOMP continuous learning profile",
  "type": "object",
  "required": [
    "profileId",
    "answeringReferencingCycle",
    "teachingBoundary",
    "skillClosure",
    "memoryBoundary",
    "ruleLearning",
    "ludicCgsBoundary",
    "implementationBoundary",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
