{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/library/predication-fibration/library/predication-fiber-algebra/fibering/fibering.schema.json",
  "title": "Fibering morphism record",
  "description": "Morphism: (a bilattice B = L|><|L, an entity set E) -> the predication fiber algebra A_p = B^(E x E). Forms the E x E index and the pointwise (product) bilattice over it, then verifies the bilattice structure lifts componentwise (pointwise negation is an involution on the fiber). The carrier is exponential in |E|^2 and is not enumerated.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["base-bilattice", "entities"],
      "additionalProperties": false,
      "properties": {
        "base-bilattice": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/variety/library/lattice/library/bilattice/bilattice.schema.json" },
        "entities": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/category/library/entity-set/entity-set.schema.json" }
      }
    },
    "output": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/library/predication-fibration/library/predication-fiber-algebra/predication-fiber-algebra.schema.json" }
  }
}
