{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/saturating/saturating.schema.json",
  "title": "Saturating morphism record",
  "description": "Morphism: a Heyting algebra A with a family of restriction homomorphisms { rho_i : A -> H_i } (to sub-history fibers) -> the nuclear dyad (A, sigma). The backward-facing saturation nucleus is sigma(a) = join { b in A | rho_i(b) <= rho_i(a) for all i }: the largest element of A with a's restriction profile. Provably a nucleus (extensive/monotone/idempotent/meet-preserving) and profile-preserving (rho_i(sigma(a)) = rho_i(a)).",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["algebra", "restrictions"],
      "additionalProperties": false,
      "properties": {
        "algebra": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/variety/library/lattice/lattice.schema.json" },
        "restrictions": {
          "description": "Restriction homomorphisms rho_i: A -> H_i. Each is a lattice H_i (the codomain) plus the map. The codomain is referenced as a lattice, not re-declared.",
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/variety/library/lattice/lattice.schema.json" }],
            "type": "object",
            "required": ["map"],
            "properties": {
              "map": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "output": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/nuclear-dyad/nuclear-dyad.schema.json" }
  }
}
