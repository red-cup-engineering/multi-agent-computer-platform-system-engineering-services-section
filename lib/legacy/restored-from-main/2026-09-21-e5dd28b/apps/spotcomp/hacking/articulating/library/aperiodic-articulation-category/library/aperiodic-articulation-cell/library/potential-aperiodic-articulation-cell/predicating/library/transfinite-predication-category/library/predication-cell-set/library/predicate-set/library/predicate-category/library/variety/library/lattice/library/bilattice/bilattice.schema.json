{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/variety/library/lattice/library/bilattice/bilattice.schema.json",
  "title": "Bilattice (twist product of a residuated lattice)",
  "description": "The twist product L|><|L of a residuated lattice L: carrier is L x L (a value [p, n] is a pair of positive and negative evidence in L), carrying two independent orders -- knowledge (<=_k: p,n both grow) and truth (<=_t: p grows, n shrinks) -- a De Morgan negation (swap [p,n] -> [n,p]), and a twist fusion/residual lifted from L's Lambek residuation. L is an arbitrary residuated lattice -- the value space is as rich as L (it is not a fixed finite set of truth-values). Value ids are the strings 'p|n'.",
  "type": "object",
  "required": ["carrier", "knowledge-leq", "truth-leq", "negation", "fusion", "residual"],
  "additionalProperties": false,
  "properties": {
    "carrier": {
      "type": "array",
      "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false, "minItems": 2, "maxItems": 2 },
      "minItems": 1
    },
    "knowledge-leq": { "$ref": "#/$defs/relation" },
    "truth-leq": { "$ref": "#/$defs/relation" },
    "negation": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
    "fusion": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } } },
    "residual": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } } }
  },
  "$defs": {
    "value": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false, "minItems": 2, "maxItems": 2 },
    "relation": {
      "type": "array",
      "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/value" }, { "$ref": "#/$defs/value" }], "items": false, "minItems": 2, "maxItems": 2 }
    }
  }
}
