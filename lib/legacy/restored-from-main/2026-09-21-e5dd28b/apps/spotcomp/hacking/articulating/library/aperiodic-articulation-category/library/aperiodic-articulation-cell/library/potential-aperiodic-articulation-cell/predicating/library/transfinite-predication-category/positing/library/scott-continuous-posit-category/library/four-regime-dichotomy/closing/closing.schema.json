{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/library/four-regime-dichotomy/closing/closing.schema.json",
  "title": "Closing morphism record",
  "description": "Morphism: a finite lattice with a monotone inflationary operator F -> the four-regime-dichotomy witness for that closure orbit. Iterates F from the bottom (Knaster-Tarski) to the least fixed point, counting the closure ordinal kappa. Since the lattice is finite, kappa is finite (kappa < omega), so the regime is strict-finite, the base is finite, the closure is Scott-continuous, and H1 vanishes -- the concrete computed instance of the dichotomy. Verifies F is monotone and inflationary.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["lattice", "operator"],
      "additionalProperties": false,
      "properties": {
        "lattice": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/predication-cell-set/library/predicate-set/library/predicate-category/library/variety/library/lattice/lattice.schema.json" },
        "operator": { "description": "The monotone inflationary operator F as a table a -> F(a).", "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "output": { "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/library/four-regime-dichotomy/four-regime-dichotomy.schema.json" }
  }
}
