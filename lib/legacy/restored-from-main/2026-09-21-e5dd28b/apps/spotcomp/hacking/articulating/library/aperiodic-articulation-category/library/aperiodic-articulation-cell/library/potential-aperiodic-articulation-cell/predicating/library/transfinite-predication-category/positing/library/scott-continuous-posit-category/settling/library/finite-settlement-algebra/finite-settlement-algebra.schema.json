  "title": "Finite settlement algebra",
  "description": "The finite settlement algebra generated by settling inside the scott-continuous posit category. Its immediate finite objects include settlement-trace-families and settlement-cell-traces: finite presentations that can be restricted back to predication-cell-traces without confusing the finite point with the Scott-continuous trace.",
  "type": "object",
  "required": [
    "settlement-trace-families",
    "settlement-cell-traces"
  ],
  "additionalProperties": false,
  "properties": {
    "settlement-trace-families": {
      "type": "array",
      "items": {
        "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/settling/library/finite-settlement-algebra/library/settlement-trace-family/settlement-trace-family.schema.json"
      }
    },
    "settlement-cell-traces": {
      "type": "array",
      "items": {
        "$ref": "https://561.group/spotcomp/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/positing/library/scott-continuous-posit-category/settling/library/finite-settlement-algebra/library/settlement-cell-trace/settlement-cell-trace.schema.json"
      }
    }
  }
}
