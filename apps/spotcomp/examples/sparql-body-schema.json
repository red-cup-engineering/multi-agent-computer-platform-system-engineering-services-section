{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rows",
    "query"
  ],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "e",
          "a",
          "v",
          "t"
        ],
        "additionalProperties": false,
        "properties": {
          "e": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "iri"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "a": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "iri"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "v": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "iri"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "literal"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "datatype": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "not": {
                  "required": [
                    "language",
                    "datatype"
                  ]
                }
              }
            ]
          },
          "t": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
